{
  "permissions": {
    "deny": [
      "Bash(darwin-rebuild switch:*)",
      "Bash(darwin-rebuild activate:*)",
      "Bash(sudo darwin-rebuild:*)",
      "Bash(git push:*)",
      "Bash(nix flake update:*)",
      "Edit(~/github/dotfiles/**)",
      "Write(~/github/dotfiles/**)",
      "Edit(~/github/nix-darwin/**)",
      "Write(~/github/nix-darwin/**)"
    ],
    "allow": [
      "Bash(nix flake check:*)",
      "Bash(nix build:*)",
      "Bash(nix eval:*)",
      "Bash(nix store diff-closures:*)",
      "Bash(darwin-rebuild build:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git branch:*)",
      "Bash(git commit:*)",
      "Bash(brew list:*)",
      "Bash(brew leaves:*)",
      "Bash(brew info:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/bin/agent-guard.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
