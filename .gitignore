# Nix build outputs
result
result-*

# macOS noise
.DS_Store

# direnv
.direnv/

# Claude Code local overrides
.claude/settings.local.json

# Claude Code skills: only repository-workflow skills are tracked
# (allowlist below). User-scope skills are not here but in
# config/agents/skills (ADR 0028); a skill an agent creates for itself, and
# skill-manager artifacts (vendored copies, lockfile), stay out.
.claude/skills/*
!.claude/skills/adr-new
!.claude/skills/preflight
!.claude/skills/ops-qa
!.claude/skills/ship-pr
!.claude/skills/keybinding-doctor
!.claude/skills/config-change
!.claude/skills/lock-review
!.claude/skills/manual-setup
# .codex/skills is deliberately absent from this file. It holds one tracked
# symlink per project skill — Codex reads a repository's skills from there and
# not from .claude/skills — and staying visible to `git status` is what shows a
# skill an agent drops beside them.
.agents/
skills-lock.json

# Secret guards (ADR 0009): these must never be committed
*.pem
*.key
id_rsa*
id_ed25519*
*.token
.env
.env.*
!.env.example
