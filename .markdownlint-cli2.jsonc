{
  // Exclude the Nix build-output symlinks. `preflight` runs markdownlint
  // (step 2) after a closure build (steps 3-4) has created `result`, and the
  // '**/*.md' glob otherwise descends into the closure and lints vendored
  // Markdown — Flutter engine licences, the Dart SDK readme — burying the
  // repository's own findings. CI never sees this (a fresh checkout has no
  // `result`), so the glob alone looked correct.
  //
  // This belongs here rather than in `.markdownlint.jsonc`: `ignores` is only
  // read from a `.markdownlint-cli2.*` config file. A `.markdownlintignore`
  // file does not work either — that is markdownlint-cli v1. Rule
  // configuration stays in `.markdownlint.jsonc`; markdownlint-cli2 reads both
  // and merges them.
  // config/nvim is an imported payload (ADR 0021, ADR 0023) that carries its
  // own conventions. ADR 0022 names its tests as stylua and the headless
  // startup check; this repository's prose lint is not among them, and
  // reformatting imported files would make the import unfaithful to the
  // archived original.
  "ignores": ["result/**", "result-*/**", "config/nvim/**"]
}
