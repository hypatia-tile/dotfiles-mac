[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = shinokun
	email = hypatia.tile02021@gmail.com
[init]
	defaultBranch = "main"
[core]
	editor = nvim
  pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
	dark = true
	navigate = true

[merge]
    conflictStyle = zdiff3

[ghq]
	root = ~/ghqrepo

[commit]
	# ~/ is expanded by git for a path-type value, so this follows $HOME instead
	# of naming one machine's. The file is projected here from config/git in this
	# repository (modules/payloads.tsv), which is why the path is absolute-from-
	# $HOME rather than relative: git resolves a relative template against the
	# current directory, not against this file.
	template = ~/.config/git/commit_template.txt
