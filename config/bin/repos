#!/usr/bin/env bash
# repos: pick, create, review and remove the repositories under ghq (#239).
#
# Each subcommand does one thing, and none of them changes directory: `pick`
# and `new` print the destination on stdout, and the abbreviations in
# config/zsh/abbreviations wrap them in `cd "$(…)"`. Prompts go to stderr and
# answers are read from /dev/tty, because stdout is captured.
#
# `repos ls` is the contract the rest is built on: one line per repository,
# tab-separated, raw values, no header.
#
#    1  path            full path
#    2  last visit      epoch; empty if never visited
#    3  last commit     epoch; empty if there is none
#    4  uncommitted     changed and untracked files
#    5  unpushed        commits on no remote, across every local branch
#    6  stashes         stash entries
#    7  personal files  files ignored by the global ignore file
#    8  worktrees       linked worktrees
#    9  roadmap open    unchecked boxes in docs/roadmap.md; empty without one
#   10  roadmap done    checked boxes in docs/roadmap.md; empty without one
#
# A count that could not be read is empty, never 0, so that `clean` treats it
# as unsafe.
set -euo pipefail

if ((BASH_VERSINFO[0] < 5)); then
  echo "repos: needs bash 5 or later, found $BASH_VERSION" >&2
  exit 2
fi

self=${BASH_SOURCE[0]}
visits_file=${XDG_STATE_HOME:-$HOME/.local/state}/repos/visits
clean_days=30

usage() {
  cat >&2 <<'EOF'
usage: repos <command> [args]

  ls [PATH...]     one tab-separated line per repository (the contract)
  status [--wip]   every repository as a table; --wip keeps work in progress
  show PATH        one repository's state and its last five commits
  pick             choose a repository with fzf; prints its path
  new [NAME]       create a repository on GitHub and clone it; prints its path
  clean            choose repositories to remove with ghq rm
  visit [DIR]      record a visit (called by the zsh chpwd hook)

To change directory, use the abbreviations:
  rp   cd "$(repos pick)"
  rn   cd "$(repos new)"
EOF
}

die() {
  echo "repos: $*" >&2
  exit 1
}

# The file whose patterns mark a file as personal: core.excludesFile, or git's
# default when it is unset.
global_ignore() {
  git config --global --path --get core.excludesFile ||
    echo "${XDG_CONFIG_HOME:-$HOME/.config}/git/ignore"
}

# count COMMAND...: the number of lines COMMAND prints, or nothing if it fails.
count() {
  local out
  out=$("$@" 2>/dev/null) || return 0
  if [[ -z $out ]]; then
    echo 0
  else
    grep -c '' <<<"$out"
  fi
}

boxes() {
  grep -cE "^[[:space:]]*[-*+] \\[$1\\]" "$2" || true
}

row() {
  local dir=$1 visit commit uncommitted unpushed stashes personal worktrees
  local open='' done='' ignore list
  visit=${last_visit[$dir]-}
  commit=$(git -C "$dir" log -1 --format=%ct 2>/dev/null) || commit=
  uncommitted=$(count git -C "$dir" status --porcelain)
  unpushed=$(git -C "$dir" rev-list --count --branches --not --remotes 2>/dev/null) || unpushed=
  stashes=$(count git -C "$dir" stash list)
  ignore=$(global_ignore)
  if [[ -f $ignore ]]; then
    personal=$(count git -C "$dir" ls-files --others --ignored --exclude-from="$ignore")
  else
    personal=0
  fi
  if list=$(git -C "$dir" worktree list --porcelain 2>/dev/null); then
    worktrees=$(grep -c '^worktree ' <<<"$list" || true)
    worktrees=$((worktrees - 1))
  else
    worktrees=
  fi
  if [[ -f $dir/docs/roadmap.md ]]; then
    open=$(boxes ' ' "$dir/docs/roadmap.md")
    done=$(boxes '[xX]' "$dir/docs/roadmap.md")
  fi
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$dir" "$visit" "$commit" \
    "$uncommitted" "$unpushed" "$stashes" "$personal" "$worktrees" "$open" "$done"
}

declare -A last_visit=()
load_visits() {
  local time path
  [[ -f $visits_file ]] || return 0
  # Lines are appended in time order, so the last one for a path wins.
  while IFS=$'\t' read -r time path; do
    last_visit[$path]=$time
  done <"$visits_file"
}

cmd_ls() {
  local dir
  if [[ $# -eq 0 ]]; then
    # One repository at a time takes seconds; batches run in parallel.
    ghq list --full-path | tr '\n' '\0' | xargs -0 -n 8 -P 8 "$self" ls |
      sort -t $'\t' -k1,1
    return
  fi
  load_visits
  for dir in "$@"; do
    dir=${dir%/}
    [[ -d $dir ]] || die "not a directory: $dir"
    row "$dir"
  done
}

# The formatter `status` and `show` share. It reads `repos ls` lines and
# prints each repository's name relative to its ghq root, ages relative to
# now, blanks for zero, and the roadmap as done/total.
format() {
  awk -F '\t' -v mode="$1" -v now="$EPOCHSECONDS" -v roots="$(ghq root --all)" '
    function age(t, d) {
      if (t == "") return ""
      d = now - t
      if (d < 3600) return int(d / 60) "m"
      if (d < 86400) return int(d / 3600) "h"
      return int(d / 86400) "d"
    }
    function blank(n) { return (n == "0") ? "" : n }
    function name(p, i) {
      for (i = 1; i <= nroots; i++)
        if (index(p, root[i] "/") == 1) return substr(p, length(root[i]) + 2)
      return p
    }
    function wip() {
      return $4 > 0 || $5 > 0 || $6 > 0 || ($10 >= 1 && $9 >= 1)
    }
    BEGIN {
      nroots = split(roots, root, "\n")
      ncols = split("repository visit commit changes unpushed stashes personal worktrees roadmap", head, " ")
    }
    mode == "wip" && !wip() { next }
    {
      n++
      cell[n, 1] = name($1)
      cell[n, 2] = age($2)
      cell[n, 3] = age($3)
      cell[n, 4] = blank($4)
      cell[n, 5] = blank($5)
      cell[n, 6] = blank($6)
      cell[n, 7] = blank($7)
      cell[n, 8] = blank($8)
      cell[n, 9] = ($9 == "" && $10 == "") ? "" : $10 "/" ($9 + $10)
    }
    END {
      if (mode == "show") {
        for (r = 1; r <= n; r++) {
          print cell[r, 1]
          for (c = 2; c <= ncols; c++)
            printf "  %-11s %s\n", head[c], (c <= 3 && cell[r, c] != "") ? cell[r, c] " ago" : cell[r, c]
        }
        exit
      }
      for (c = 1; c <= ncols; c++) width[c] = length(head[c])
      for (r = 1; r <= n; r++)
        for (c = 1; c <= ncols; c++)
          if (length(cell[r, c]) > width[c]) width[c] = length(cell[r, c])
      for (c = 1; c <= ncols; c++)
        printf "%-" width[c] "s%s", head[c], (c < ncols) ? "  " : "\n"
      for (r = 1; r <= n; r++)
        for (c = 1; c <= ncols; c++)
          printf "%" (c == 1 ? "-" : "") width[c] "s%s", cell[r, c], (c < ncols) ? "  " : "\n"
    }'
}

# Most recent visit first; never visited last, by path.
by_visit() {
  sort -t $'\t' -k2,2nr -k1,1
}

cmd_status() {
  local mode=table
  case ${1-} in
    '') ;;
    --wip) mode=wip ;;
    *) die "status: unknown option: $1" ;;
  esac
  cmd_ls | by_visit | format "$mode"
}

cmd_show() {
  [[ $# -eq 1 ]] || die "show: needs one PATH"
  cmd_ls "$1" | format show
  echo
  git -C "$1" log --oneline --decorate --color=always -5 2>/dev/null || true
}

cmd_pick() {
  local choice
  load_visits
  choice=$(
    ghq list --full-path | while IFS= read -r dir; do
      printf '%s\t%s\n' "$dir" "${last_visit[$dir]-}"
    done | by_visit | awk -F '\t' -v roots="$(ghq root --all)" '
      BEGIN { nroots = split(roots, root, "\n") }
      {
        name = $1
        for (i = 1; i <= nroots; i++)
          if (index($1, root[i] "/") == 1) { name = substr($1, length(root[i]) + 2); break }
        print $1 "\t" name
      }' |
      fzf --delimiter '\t' --with-nth 2 --tiebreak index \
        --preview "$(printf '%q' "$self") show {1}"
  ) || return 0
  [[ -n $choice ]] || return 0
  printf '%s\n' "${choice%%$'\t'*}"
}

# ask PROMPT: read one answer from the terminal into $answer.
ask() {
  read -r -p "$1" answer </dev/tty
}

cmd_new() {
  local name=${1-} answer visibility url slug dir
  local args=()
  if [[ -z $name ]]; then
    ask 'Name: ' || exit 1
    name=$answer
  fi
  [[ -n $name ]] || die "new: no name; nothing created"
  # Required, with no default: forgetting it is the failure this exists for.
  # `p` is ambiguous, so the short forms are the second letters.
  while :; do
    ask 'Visibility (public/private): ' || exit 1
    case $answer in
      public | u) visibility=--public && break ;;
      private | r) visibility=--private && break ;;
    esac
  done
  args=("$name" "$visibility")
  while :; do
    ask 'Add README and MIT license? [Y/n] ' || exit 1
    case $answer in
      '' | [Yy] | [Yy]es) args+=(--add-readme --license=MIT) && break ;;
      [Nn] | [Nn]o) break ;;
    esac
  done
  url=$(gh repo create "${args[@]}") || die "new: gh repo create failed"
  slug=${url#https://}
  ghq get -p "$slug" >&2 || die "new: created $url, but ghq get failed"
  dir=$(ghq list --full-path --exact "$slug")
  [[ -d $dir ]] || die "new: cloned $slug, but cannot find it under ghq root"
  printf '%s\n' "$dir"
}

# A candidate is one a fresh clone restores exactly, not visited for
# $clean_days days. A repository never visited counts as visited when the
# record began, so nothing is offered for the first $clean_days days.
candidates() {
  local start=$1
  awk -F '\t' -v now="$EPOCHSECONDS" -v start="$start" -v min=$((clean_days * 86400)) '
    $4 == "0" && $5 == "0" && $6 == "0" && $7 == "0" && $8 == "0" {
      v = ($2 == "") ? start : $2
      if (now - v >= min) print v "\t" $1
    }'
}

cmd_clean() {
  local start chosen dir name
  [[ -s $visits_file ]] || die "clean: no visits recorded yet, so nothing is a candidate"
  start=$(head -n 1 "$visits_file" | cut -f 1)
  chosen=$(
    cmd_ls | candidates "$start" | sort -t $'\t' -k1,1n |
      awk -F '\t' -v now="$EPOCHSECONDS" -v roots="$(ghq root --all)" '
        BEGIN { nroots = split(roots, root, "\n") }
        {
          name = $2
          for (i = 1; i <= nroots; i++)
            if (index($2, root[i] "/") == 1) { name = substr($2, length(root[i]) + 2); break }
          printf "%s\t%s\t%dd since visit\n", $2, name, (now - $1) / 86400
        }' |
      fzf --multi --delimiter '\t' --with-nth 2,3 --tiebreak index \
        --header 'Tab selects; Enter removes the selection with ghq rm, which asks for each' \
        --preview "$(printf '%q' "$self") show {1}"
  ) || return 0
  [[ -n $chosen ]] || return 0
  while IFS=$'\t' read -r dir name _; do
    # Checked again: the state may have changed while the list was open.
    if [[ -z $(cmd_ls "$dir" | candidates "$start") ]]; then
      echo "repos: $name is no longer safe to remove; skipped" >&2
      continue
    fi
    ghq rm "$name" </dev/tty
  done <<<"$chosen"
}

cmd_visit() {
  local dir=${1:-$PWD} top root last=''
  top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || return 0
  while IFS= read -r root; do
    [[ $top == "$root"/* ]] || continue
    if [[ -f $visits_file ]]; then
      last=$(tail -n 1 "$visits_file" | cut -f 2)
    fi
    [[ $last == "$top" ]] && return 0
    mkdir -p "${visits_file%/*}"
    printf '%s\t%s\n' "$EPOCHSECONDS" "$top" >>"$visits_file"
    return 0
  done < <(ghq root --all)
}

[[ $# -gt 0 ]] || {
  usage
  exit 1
}
command=$1
shift
case $command in
  ls) cmd_ls "$@" ;;
  status) cmd_status "$@" ;;
  show) cmd_show "$@" ;;
  pick) cmd_pick ;;
  new) cmd_new "$@" ;;
  clean) cmd_clean ;;
  visit) cmd_visit "$@" ;;
  -h | --help | help) usage ;;
  *)
    usage
    exit 1
    ;;
esac
